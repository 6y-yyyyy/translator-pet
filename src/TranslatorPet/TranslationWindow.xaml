<Window xmlns='http://schemas.microsoft.com/winfx/2006/xaml/presentation' xmlns:x='http://schemas.microsoft.com/winfx/2006/xaml' Title='随身翻译' Width='412' Height='572' WindowStyle='None' AllowsTransparency='True' Background='Transparent' ResizeMode='NoResize' ShowInTaskbar='False' Topmost='True' FontFamily='Microsoft YaHei UI' FontSize='13' Foreground='#282840'>
<Window.Resources>
<Style TargetType='Button'><Setter Property='Cursor' Value='Hand'/><Setter Property='Height' Value='34'/><Setter Property='Padding' Value='12,0'/><Setter Property='Background' Value='#F2F1FA'/><Setter Property='BorderThickness' Value='0'/><Setter Property='Foreground' Value='#55516E'/><Setter Property='Template'><Setter.Value><ControlTemplate TargetType='Button'><Border x:Name='B' CornerRadius='8' Background='{TemplateBinding Background}' Padding='{TemplateBinding Padding}'><ContentPresenter HorizontalAlignment='Center' VerticalAlignment='Center'/></Border><ControlTemplate.Triggers><Trigger Property='IsMouseOver' Value='True'><Setter TargetName='B' Property='Opacity' Value='0.8'/></Trigger><Trigger Property='IsEnabled' Value='False'><Setter TargetName='B' Property='Opacity' Value='0.4'/></Trigger><Trigger Property='IsPressed' Value='True'><Setter TargetName='B' Property='Opacity' Value='0.6'/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType='ComboBox'><Setter Property='Width' Value='112'/><Setter Property='Height' Value='30'/><Setter Property='FontSize' Value='12'/><Setter Property='VerticalContentAlignment' Value='Center'/><Setter Property='Margin' Value='0,0,0,0'/></Style>
<Style TargetType='TextBox'><Setter Property='Background' Value='Transparent'/><Setter Property='BorderThickness' Value='0'/><Setter Property='FontSize' Value='15'/><Setter Property='TextWrapping' Value='Wrap'/><Setter Property='AcceptsReturn' Value='True'/><Setter Property='VerticalScrollBarVisibility' Value='Auto'/><Setter Property='Padding' Value='0,8,3,0'/><Setter Property='SelectionBrush' Value='#B9B0FA'/></Style>
</Window.Resources>
<Border Background='White' BorderBrush='#DAD6EA' BorderThickness='1' CornerRadius='16' Margin='6' Padding='18,12,18,16'>
<Grid><Grid.RowDefinitions><RowDefinition Height='38'/><RowDefinition Height='10'/><RowDefinition Height='182'/><RowDefinition Height='34'/><RowDefinition Height='172'/><RowDefinition Height='12'/><RowDefinition Height='36'/><RowDefinition Height='*'/></Grid.RowDefinitions>
<Border x:Name='TitleBar' Background='Transparent'><Grid><StackPanel Orientation='Horizontal' VerticalAlignment='Center'><TextBlock Text='文/A' FontSize='14' Foreground='#8270E4' FontWeight='Bold' Margin='0,0,10,0'/><TextBlock Text='随身翻译' FontSize='17' FontWeight='SemiBold'/></StackPanel><StackPanel Orientation='Horizontal' HorizontalAlignment='Right'><Button x:Name='MoreButton' Content='···' Width='32' Padding='0' Background='Transparent' ToolTip='外观与设置'/><Button x:Name='CloseButton' Content='×' FontSize='21' Width='32' Padding='0' Background='Transparent' ToolTip='收起窗口（Esc）'/></StackPanel></Grid></Border>
<Border Grid.Row='2' Background='#FBFAFE' BorderBrush='#E7E3F2' BorderThickness='1' CornerRadius='10' Padding='12,10'><Grid><Grid.RowDefinitions><RowDefinition Height='30'/><RowDefinition Height='*'/><RowDefinition Height='18'/></Grid.RowDefinitions><TextBlock Text='原文' Foreground='#827C95' VerticalAlignment='Center'/><ComboBox x:Name='SourceLanguage' HorizontalAlignment='Right' ToolTip='原文语言'/><TextBox x:Name='InputBox' Grid.Row='1' MaxLength='10000' ToolTip='粘贴要翻译的单词或句子；Ctrl+Enter 翻译'/><TextBlock x:Name='CountText' Grid.Row='2' Text='0 / 10,000' FontSize='10' Foreground='#A09AAF' HorizontalAlignment='Right'/></Grid></Border>
<Button x:Name='SwapButton' Grid.Row='3' Content='⇅' FontSize='18' Height='26' Width='38' Padding='0' HorizontalAlignment='Center' VerticalAlignment='Center' Background='Transparent' ToolTip='交换两种语言；有译文时也交换文字'/>
<Border Grid.Row='4' Background='#FBFAFE' BorderBrush='#E7E3F2' BorderThickness='1' CornerRadius='10' Padding='12,10'><Grid><Grid.RowDefinitions><RowDefinition Height='30'/><RowDefinition Height='*'/></Grid.RowDefinitions><TextBlock Text='译文' Foreground='#827C95' VerticalAlignment='Center'/><ComboBox x:Name='TargetLanguage' HorizontalAlignment='Right' ToolTip='译文语言'/><TextBox x:Name='OutputBox' Grid.Row='1' IsReadOnly='True' ToolTip='翻译结果，可选中文字复制'/></Grid></Border>
<Grid Grid.Row='6'><Grid.ColumnDefinitions><ColumnDefinition Width='70'/><ColumnDefinition Width='8'/><ColumnDefinition Width='70'/><ColumnDefinition Width='*'/><ColumnDefinition Width='92'/><ColumnDefinition Width='8'/><ColumnDefinition Width='90'/></Grid.ColumnDefinitions><Button x:Name='PasteButton' Content='粘贴' Grid.Column='0'/><Button x:Name='ClearButton' Content='清空' Grid.Column='2'/><Button x:Name='CopyButton' Content='复制译文' Grid.Column='4'/><Button x:Name='TranslateButton' Content='翻译  ↵' Grid.Column='6' Background='#8773E8' Foreground='White' FontWeight='SemiBold' ToolTip='Ctrl+Enter'/></Grid>
<StackPanel Grid.Row='7' VerticalAlignment='Bottom'><TextBlock x:Name='StatusText' Text='复制文字后，点击粘贴再翻译' FontSize='11' TextWrapping='Wrap' Foreground='#7E758F'/><TextBlock Text='离线中英互译 · 不上传原文 · 无每日次数限制' FontSize='10' Foreground='#AAA2B7' Margin='0,5,0,0'/></StackPanel>
</Grid></Border></Window>